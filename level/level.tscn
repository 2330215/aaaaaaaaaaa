[node name="DialogueEnemy1" parent="." unique_id=959384139 instance=ExtResource("9_cw150")]
position = Vector2(700, 320)
speaker_name = "GUARDIÁN DEL NIVEL 1"
dialogue_lines = ["¡Hola viajero! Bienvenido al primer nivel.", "Camina hacia el extremo derecho para encontrar la moneda brillante...", "Te llevará a los niveles inferiores si te atreves a descender."]

[node name="DialogueEnemy2" parent="." unique_id=126628178 instance=ExtResource("9_cw150")]
position = Vector2(700, 2112)
speaker_name = "VIGILANTE DEL POZO"
dialogue_lines = ["¡Cuidado! Más adelante hay un pozo oscuro sin fondo.", "Si te descuidas y caes, perderás y regresarás al inicio del juego.", "¡Salte con fuerza para cruzarlo al otro lado!"]

[node name="DialogueEnemy3" parent="." unique_id=1487875739 instance=ExtResource("9_cw150")]
position = Vector2(700, 3840)
speaker_name = "ESPECTRO DE LA CUEVA"
dialogue_lines = ["Has llegado a las profundidades oscuras de la cueva...", "La última moneda especial te aguarda al final del camino.", "Tócala para regresar victorioso a la superficie."]
